{
  "name": "trakify",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --headless",
    "test:coverage": "ng test --coverage --no-watch --headless",
    "deploy": "ng deploy",
    "lint": "ng lint --fix",
    "lint:check": "ng lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "pnpm format && pnpm lint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/fire": "20.1.1",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@tanstack/angular-query": "^5.0.0-rc.5",
    "@tanstack/angular-query-devtools": "^5.0.0-rc.5",
    "angular-oauth2-oidc": "^22.0.2",
    "date-fns": "^4.4.0",
    "photoswipe": "^5.4.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "oxfmt": "^0.74.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
